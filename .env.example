# Configuração do MJR Downloader

# Porta do Servidor (Padrão: 3000)
PORT=3000

# Provedor de Mídia: 'local' (yt-dlp local) ou 'worker' (microsserviço externo)
MEDIA_PROVIDER=local

# Caminho opcional para o executável yt-dlp ou launcher Python
# Se vazio, o sistema detecta automaticamente 'yt-dlp', 'py -m yt_dlp' ou 'python -m yt_dlp'
YTDLP_PATH=

# Caminho opcional para o executável ffmpeg
# Se vazio, o sistema detecta automaticamente 'ffmpeg' no PATH
FFMPEG_PATH=

# URL do Worker Externo (caso MEDIA_PROVIDER=worker)
# WORKER_URL=http://localhost:4000
# WORKER_API_KEY=sua_chave_secreta

# Limite de Taxa (Rate Limiting)
RATE_LIMIT_ANALYZE_MAX=20
RATE_LIMIT_DOWNLOAD_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Limite máximo de tamanho de download permitido (em bytes - padrão 500MB)
MAX_DOWNLOAD_SIZE_BYTES=524288000
